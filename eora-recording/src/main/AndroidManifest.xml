<?xml version="1.0" encoding="utf-8"?>
<!--
    Opt-in screen recording for Eora. Both permissions are install-time (no runtime prompt); the user still
    consents to every recording in the system dialog. No microphone, no notification permission request.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <service
            android:name="com.easyhooon.eora.internal.recording.ScreenRecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name="com.easyhooon.eora.internal.recording.RecordingConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
